rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 7 && id.size() <= 24 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSharedBouquet(data, docId) {
      return data.keys().hasAll(['code', 'payload', 'createdAt']) &&
        data.keys().hasOnly([
          'code',
          'payload',
          'voiceAudioDataUrl',
          'voiceStyle',
          'voiceTitle',
          'voiceDurationSec',
          'openCount',
          'voicePlayCount',
          'reaction',
          'recipientReply',
          'repliedAt',
          'createdAt'
        ]) &&
        data.code is string &&
        data.code == docId &&
        data.code.size() >= 7 &&
        data.code.size() <= 24 &&
        data.code.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.payload is string &&
        data.payload.size() >= 3 &&
        data.payload.size() <= 900000 &&
        (!('voiceAudioDataUrl' in data) || (data.voiceAudioDataUrl is string && data.voiceAudioDataUrl.size() <= 900000)) &&
        (!('voiceStyle' in data) || (data.voiceStyle is string && data.voiceStyle.size() >= 1 && data.voiceStyle.size() <= 32)) &&
        (!('voiceTitle' in data) || (data.voiceTitle is string && data.voiceTitle.size() <= 64)) &&
        (!('voiceDurationSec' in data) || (data.voiceDurationSec is number && data.voiceDurationSec >= 0 && data.voiceDurationSec <= 600)) &&
        (!('openCount' in data) || (data.openCount is number && data.openCount >= 0 && data.openCount <= 1000000)) &&
        (!('voicePlayCount' in data) || (data.voicePlayCount is number && data.voicePlayCount >= 0 && data.voicePlayCount <= 1000000)) &&
        (!('reaction' in data) || (data.reaction is string && data.reaction.size() <= 32)) &&
        (!('recipientReply' in data) || (data.recipientReply is string && data.recipientReply.size() <= 240)) &&
        (!('repliedAt' in data) || (data.repliedAt is string && data.repliedAt.size() <= 64)) &&
        data.createdAt is string &&
        data.createdAt.size() >= 10 &&
        data.createdAt.size() <= 64;
    }

    function isValidStudioStats(data) {
      return data.keys().hasAll([
          'bouquetsCreated',
          'voiceNotesRecorded',
          'bouquetsOpened',
          'reactionsSent',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'bouquetsCreated',
          'voiceNotesRecorded',
          'bouquetsOpened',
          'reactionsSent',
          'updatedAt'
        ]) &&
        data.bouquetsCreated is number && data.bouquetsCreated >= 0 && data.bouquetsCreated <= 100000000 &&
        data.voiceNotesRecorded is number && data.voiceNotesRecorded >= 0 && data.voiceNotesRecorded <= 100000000 &&
        data.bouquetsOpened is number && data.bouquetsOpened >= 0 && data.bouquetsOpened <= 100000000 &&
        data.reactionsSent is number && data.reactionsSent >= 0 && data.reactionsSent <= 100000000 &&
        data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    match /shared_bouquets/{code} {
      allow get: if isValidId(code);
      allow list: if false;
      allow create: if isValidId(code) && isValidSharedBouquet(incoming(), code);
      allow update: if isValidId(code) &&
        isValidSharedBouquet(incoming(), code) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'payload',
          'voiceAudioDataUrl',
          'voiceStyle',
          'voiceTitle',
          'voiceDurationSec',
          'openCount',
          'voicePlayCount',
          'reaction',
          'recipientReply',
          'repliedAt'
        ]);
      allow delete: if false;
    }

    match /studio_stats/{statId} {
      allow get: if statId == 'global';
      allow list: if false;
      allow create, update: if statId == 'global' && isValidStudioStats(incoming());
      allow delete: if false;
    }
  }
}
