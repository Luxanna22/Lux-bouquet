# SikatPay PH Payments (QR Ph, GCash, Maya)
# Test keys start with mk_test_... (usable before KYC approval); Live keys start with mk_...
SIKATPAY_API_KEY=
# Webhook signing secret (whsec_...) from SikatPay Dashboard -> Developers
SIKATPAY_WEBHOOK_SECRET=
# Optional override (defaults to https://payment.sikatpinoy.net/api/v1)
SIKATPAY_API_BASE_URL=https://payment.sikatpinoy.net/api/v1

# Ko-fi International Shop Integration
KOFI_VERIFICATION_TOKEN=
KOFI_PAGE_URL=

# Optional Security & Admin Secrets
PASS_SIGNING_SECRET=
OWNER_ADMIN_PIN=

# Optional Admin-Only Analytics AI Advisor (Server-Side Only)
GEMINI_API_KEY=

# Legacy PH Gateways (optional fallbacks)
BAYADGATE_MERCHANT_ID=
BAYADGATE_SECRET_KEY=
BAYADGATE_API_BASE_URL=https://BayadGate.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
